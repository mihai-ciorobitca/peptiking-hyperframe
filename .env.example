SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# No OpenAI API key. Run npm run login to use your ChatGPT account on this laptop.
# Astra Light means the supported Astra model with Low reasoning.
HYPERFRAMES_MODEL=gpt-6-astra
HYPERFRAMES_REASONING_EFFORT=low
HYPERFRAMES_WHISPER_MODEL=base
HYPERFRAMES_AUTO_ASSETS=true
HYPERFRAMES_JOB_TIMEOUT_MINUTES=60
# Flow is loaded automatically using the existing Supabase worker login.
# Optional overrides for a different installation (not OpenAI credentials):
# FLOW_API_URL=
# FLOW_API_KEY=
# If Pixabay requires verification, run npm run music:open once, then restart the worker.
# HYPERFRAMES_MUSIC_HEADLESS=false
# Optional: use a specific existing Codex login directory; credentials are never copied.
# HYPERFRAMES_CODEX_HOME=C:/Users/YOUR_USER/.codex
# Optional: Python with faster-whisper installed; default is the setup-created .venv.
# HYPERFRAMES_PYTHON=C:/PeptiKing/HyperFrames/.venv/Scripts/python.exe
# Use the same export bucket as BORUMI_EXPORT_BUCKET on the website.
HYPERFRAMES_EXPORT_BUCKET=shotstack
# Add exact source-media hosts only if your website uses another storage host.
HYPERFRAMES_MEDIA_HOSTS=storage.googleapis.com
# Optional: absolute path for keeping editable HyperFrames projects.
# HYPERFRAMES_PROJECTS_DIR=C:/PeptiKing/HyperFrames/projects
# Optional: installed Chrome if automatic discovery does not find it.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
HYPERFRAMES_MAX_SOURCE_MB=2048
