    "smoke:codex": "node --env-file-if-exists=.env smoke-codex.mjs"
  },
  "dependencies": {
    "@openai/codex": "0.154.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "gsap": "3.15.0",
    "hyperframes": "0.8.35"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
