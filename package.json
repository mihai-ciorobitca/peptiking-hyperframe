{
  "name": "peptiking-hyperframes-worker",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "node --env-file-if-exists=.env codex.mjs login",
    "music:open": "node --env-file-if-exists=.env pixabay.mjs open-music",
    "smoke:assets": "node --env-file-if-exists=.env smoke-assets.mjs",
    "smoke:music": "node smoke-music.mjs",
    "smoke:music:live": "node --env-file-if-exists=.env smoke-music-live.mjs",
    "start": "node --env-file=.env worker.mjs",
    "doctor": "node --env-file-if-exists=.env doctor.mjs",
    "test": "node --test *.test.mjs",
    "smoke": "node smoke.mjs",
    "smoke:codex": "node --env-file-if-exists=.env smoke-codex.mjs",
    "smoke:recovery": "node smoke-recovery.mjs",
    "smoke:framing": "node smoke-framing.mjs",
    "smoke:transitions": "node smoke-transitions.mjs"
  },
  "dependencies": {
    "@openai/codex": "0.154.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "gsap": "3.15.0",
    "hyperframes": "0.8.35",
    "playwright-core": "1.61.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
